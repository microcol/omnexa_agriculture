  {"fieldname": "country", "fieldtype": "Link", "label": "Country", "options": "Country"},
  {"fieldname": "timezone", "fieldtype": "Data", "label": "Timezone", "description": "IANA timezone, e.g. Africa/Cairo or Europe/London."},
  {"fieldname": "operating_currency", "fieldtype": "Link", "label": "Operating Currency", "options": "Currency"},
  {"fieldname": "global_gap_cert_no", "fieldtype": "Data", "label": "GlobalG.A.P Certificate No"},
  {"fieldname": "global_gap_valid_until", "fieldtype": "Date", "label": "GlobalG.A.P Valid Until"},
  {"fieldname": "ifrs_valuation_method", "fieldtype": "Select", "label": "IAS 41 Valuation Method", "options": "Fair Value less Costs to Sell\nCost Model (exception)", "default": "Fair Value less Costs to Sell"},
  {"fieldname": "biological_asset_account", "fieldtype": "Link", "label": "Biological Asset Account", "options": "GL Account", "description": "Debit/Credit side for biological asset valuation postings."},
  {"fieldname": "ias41_gain_loss_account", "fieldtype": "Link", "label": "IAS 41 Gain/Loss Account", "options": "GL Account", "description": "P&L account used for fair value gains or losses."},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_list_view": 1},
  {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Branch", "reqd": 1, "in_list_view": 1},
  {"fieldname": "total_area_acre", "fieldtype": "Float", "label": "Total Area (Acre)"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Planned\nActive\nSuspended", "default": "Active", "in_list_view": 1}
 ],
